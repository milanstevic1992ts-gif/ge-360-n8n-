# GE360 n8n
COMPOSE_PROJECT_NAME=ge360_n8n
N8N_VERSION=2.39.8
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Rome
TZ=Europe/Rome

# Jarvis Code / n8n-MCP (solo locale)
JARVIS_MCP_PORT=3001

# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# IMPORTANT: non cambiare questa chiave dopo aver creato credenziali n8n.
N8N_ENCRYPTION_KEY=CHANGE_ME

# Community nodes gestiti dai pack GE360 (n8n >= 2.21)
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_COMMUNITY_PACKAGES_MANAGED_BY_ENV=true
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_REINSTALL_MISSING_PACKAGES=true
N8N_COMMUNITY_PACKAGES=[]
