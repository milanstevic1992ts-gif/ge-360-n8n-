#!/usr/bin/env bash
set -Eeuo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/deploy/compose.yml"
STATE_DIR="$ROOT/.state"
ENABLED_FILE="$STATE_DIR/enabled-packs.txt"
FLOW_INDEX="$STATE_DIR/flow-index.tsv"

mkdir -p "$STATE_DIR" "$ROOT/packs-extra" "$ROOT/backups"

say(){ printf '\033[1;36m[GE360]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[GE360]\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31m[GE360 ERROR]\033[0m %s\n' "$*" >&2; exit 1; }

need_env(){
  [[ -f "$ENV_FILE" ]] || die "Manca .env. Esegui prima: sudo bash ./install.sh"
}

docker_cmd(){
  if docker info >/dev/null 2>&1; then
    docker "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo docker "$@"
  else
    die "Docker non accessibile."
  fi
}

dc(){
  need_env
  docker_cmd compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

health(){
  need_env
  local port
  port="$(awk -F= '$1=="N8N_PORT"{print $2}' "$ENV_FILE" | tail -1)"
  [[ -n "$port" ]] || port=5678
  curl -fsS "http://127.0.0.1:${port}/healthz"
}

wait_health(){
  for _ in $(seq 1 90); do
    if health >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

manifest_dir(){
  local id="$1"
  if [[ -f "$ROOT/packs/$id/pack.json" ]]; then
    printf '%s\n' "$ROOT/packs/$id"
  elif [[ -f "$ROOT/packs-extra/$id/pack.json" ]]; then
    printf '%s\n' "$ROOT/packs-extra/$id"
  else
    return 1
  fi
}

container_pack_dir(){
  local dir="$1"
  if [[ "$dir" == "$ROOT/packs/"* ]]; then
    printf '/opt/ge360/packs/%s\n' "${dir#"$ROOT/packs/"}"
  elif [[ "$dir" == "$ROOT/packs-extra/"* ]]; then
    printf '/opt/ge360/packs-extra/%s\n' "${dir#"$ROOT/packs-extra/"}"
  else
    return 1
  fi
}

pack_list(){
  printf '%-14s %-9s %-18s %s\n' "PACK" "STATO" "VERSIONE" "DESCRIZIONE"
  for m in "$ROOT"/packs/*/pack.json "$ROOT"/packs-extra/*/pack.json; do
    [[ -f "$m" ]] || continue
    local id version desc state
    id="$(jq -r '.id' "$m")"
    version="$(jq -r '.version // "-"' "$m")"
    desc="$(jq -r '.description // ""' "$m")"
    state="off"
    grep -Fxq "$id" "$ENABLED_FILE" 2>/dev/null && state="ON"
    printf '%-14s %-9s %-18s %s\n' "$id" "$state" "$version" "$desc"
  done
}

render_packages(){
  need_env
  python3 - "$ROOT" "$ENABLED_FILE" "$ENV_FILE" <<'PY'
from pathlib import Path
import json, sys
root=Path(sys.argv[1]); enabled=Path(sys.argv[2]); envp=Path(sys.argv[3])
ids=[]
if enabled.exists():
    ids=[x.strip() for x in enabled.read_text().splitlines() if x.strip()]
packages={}
for pid in ids:
    for base in (root/"packs", root/"packs-extra"):
        p=base/pid/"pack.json"
        if not p.exists():
            continue
        data=json.loads(p.read_text())
        for pkg in data.get("community_packages", []):
            name=pkg["name"]
            packages[name]={"name":name, **({"version":str(pkg["version"])} if pkg.get("version") else {})}
        break
value=json.dumps(list(packages.values()), separators=(",",":"))
lines=envp.read_text().splitlines()
out=[]
done=False
for line in lines:
    if line.startswith("N8N_COMMUNITY_PACKAGES="):
        out.append("N8N_COMMUNITY_PACKAGES='"+value+"'")
        done=True
    else:
        out.append(line)
if not done:
    out.append("N8N_COMMUNITY_PACKAGES='"+value+"'")
envp.write_text("\n".join(out)+"\n")
print(value)
PY
}

pack_import(){
  local id="$1" dir cdir
  dir="$(manifest_dir "$id")" || die "Pack '$id' non trovato."
  [[ -d "$dir/workflows" ]] || { say "Pack '$id': nessun workflow da importare."; return 0; }
  if ! find "$dir/workflows" -maxdepth 1 -type f -name '*.json' -print -quit | grep -q .; then
    say "Pack '$id': nessun workflow JSON da importare."
    return 0
  fi
  cdir="$(container_pack_dir "$dir")"
  say "Import workflow del pack '$id'..."
  dc exec -T n8n n8n import:workflow --separate --input="$cdir/workflows/"
}

pack_sync(){
  render_packages >/dev/null
  say "Riconcilio community nodes dei pack attivi..."
  dc up -d n8n
  wait_health || die "n8n non è tornato healthy dopo la sincronizzazione pack."
}

pack_enable(){
  local id="$1"
  manifest_dir "$id" >/dev/null || die "Pack '$id' non trovato."
  touch "$ENABLED_FILE"
  if ! grep -Fxq "$id" "$ENABLED_FILE"; then
    printf '%s\n' "$id" >> "$ENABLED_FILE"
  fi
  render_packages >/dev/null
  say "Pack '$id' abilitato. Riavvio n8n e installo le dipendenze..."
  dc up -d n8n
  wait_health || die "n8n non è healthy dopo l'abilitazione di '$id'."
  pack_import "$id"
}

pack_disable(){
  local id="$1"
  touch "$ENABLED_FILE"
  grep -Fxv "$id" "$ENABLED_FILE" > "$ENABLED_FILE.tmp" || true
  mv "$ENABLED_FILE.tmp" "$ENABLED_FILE"
  render_packages >/dev/null
  say "Pack '$id' disabilitato. I workflow già importati non vengono cancellati."
  dc up -d n8n
  wait_health || die "n8n non è healthy dopo la disabilitazione di '$id'."
}

pack_add(){
  local url="$1" slug dir
  slug="${url##*/}"; slug="${slug%.git}"
  [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || die "Nome repository non valido."
  dir="$ROOT/packs-extra/$slug"
  [[ ! -e "$dir" ]] || die "Esiste già: $dir"
  say "Clono pack esterno '$slug'..."
  git clone --depth 1 "$url" "$dir"
  rm -rf "$dir/.git"
  [[ -f "$dir/pack.json" ]] || { rm -rf "$dir"; die "Pack rifiutato: manca pack.json nella root."; }
  jq -e '.id and .name and (.community_packages|type=="array")' "$dir/pack.json" >/dev/null ||
    { rm -rf "$dir"; die "pack.json non valido."; }
  say "Pack aggiunto. Attivalo con: ge360ctl pack enable $(jq -r '.id' "$dir/pack.json")"
}

flow_index(){
  local lib="$ROOT/upstream/workflow-libraries"
  [[ -d "$lib" ]] || die "Libreria workflow non trovata."
  : > "$FLOW_INDEX"
  say "Indicizzo la libreria workflow..."
  while IFS= read -r -d '' f; do
    local rel name
    rel="${f#"$lib/"}"
    name="$(jq -r 'if type=="object" then (.name // empty) elif type=="array" and length>0 then (.[0].name // empty) else empty end' "$f" 2>/dev/null || true)"
    [[ -n "$name" ]] || name="$(basename "$f" .json)"
    printf '%s\t%s\n' "$name" "$rel" >> "$FLOW_INDEX"
  done < <(find "$lib" -type f -name '*.json' -print0)
  sort -f -o "$FLOW_INDEX" "$FLOW_INDEX"
  say "Indice creato: $(wc -l < "$FLOW_INDEX") workflow."
}

flow_search(){
  local q="$*"
  [[ -s "$FLOW_INDEX" ]] || flow_index
  grep -iF -- "$q" "$FLOW_INDEX" | head -n 80 || true
}

flow_import(){
  local rel="$1" src container
  [[ "$rel" != /* && "$rel" != *".."* ]] || die "Percorso non valido."
  src="$ROOT/upstream/workflow-libraries/$rel"
  [[ -f "$src" ]] || die "Workflow non trovato: $rel"
  case "$src" in "$ROOT/upstream/workflow-libraries/"*) ;; *) die "Percorso non consentito.";; esac
  container="/opt/ge360/library/$rel"
  say "Importo: $rel"
  dc exec -T n8n n8n import:workflow --input="$container"
}

backup_all(){
  local stamp="/opt/ge360/backups/$(date +%Y%m%d-%H%M%S)"
  say "Backup workflow e credenziali cifrate..."
  dc exec -T n8n mkdir -p "$stamp/workflows" "$stamp/credentials"
  dc exec -T n8n n8n export:workflow --backup --output="$stamp/workflows/"
  dc exec -T n8n n8n export:credentials --backup --output="$stamp/credentials/"
  say "Backup salvato in $ROOT/backups/"
}

update_all(){
  say "Aggiorno repository..."
  git -C "$ROOT" pull --ff-only
  say "Aggiorno immagini..."
  dc pull
  pack_sync
  flow_index
}

usage(){
cat <<'EOF'
GE360 n8n controller

Uso:
  ge360ctl start | stop | restart | status | health
  ge360ctl logs [opzioni docker compose logs]
  ge360ctl update
  ge360ctl backup

  ge360ctl pack list
  ge360ctl pack enable <id>
  ge360ctl pack disable <id>
  ge360ctl pack import <id>
  ge360ctl pack sync
  ge360ctl pack add <git-url>

  ge360ctl flow index
  ge360ctl flow search <testo>
  ge360ctl flow import <percorso-relativo>

Esempi:
  ge360ctl pack enable crm
  ge360ctl pack enable ai
  ge360ctl flow search wordpress
  ge360ctl flow import zie619-n8n-workflows/.../workflow.json
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  start) dc up -d ;;
  stop) dc down ;;
  restart) dc restart ;;
  status) dc ps ;;
  health) health ;;
  logs) dc logs "$@" ;;
  update) update_all ;;
  backup) backup_all ;;
  pack)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) pack_list ;;
      enable) [[ $# -eq 1 ]] || die "Uso: ge360ctl pack enable <id>"; pack_enable "$1" ;;
      disable) [[ $# -eq 1 ]] || die "Uso: ge360ctl pack disable <id>"; pack_disable "$1" ;;
      import) [[ $# -eq 1 ]] || die "Uso: ge360ctl pack import <id>"; pack_import "$1" ;;
      sync) pack_sync ;;
      add) [[ $# -eq 1 ]] || die "Uso: ge360ctl pack add <git-url>"; pack_add "$1" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  flow)
    sub="${1:-}"; shift || true
    case "$sub" in
      index) flow_index ;;
      search) [[ $# -ge 1 ]] || die "Uso: ge360ctl flow search <testo>"; flow_search "$@" ;;
      import) [[ $# -eq 1 ]] || die "Uso: ge360ctl flow import <percorso>"; flow_import "$1" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
